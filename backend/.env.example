AGENTDOCK_SERVICE_NAME=AgentDock API
AGENTDOCK_APP_VERSION=0.2.0
AGENTDOCK_ENVIRONMENT=development

# API only: restricted application role (NOSUPERUSER, NOBYPASSRLS).
AGENTDOCK_DATABASE_URL=postgresql+asyncpg://agentdock_runtime:CHANGE_ME@localhost:5432/agentdock

# Worker only: separate least-privilege role; never reuse the API/migrator credentials.
AGENTDOCK_WORKER_DATABASE_URL=postgresql+asyncpg://agentdock_worker:CHANGE_ME@localhost:5432/agentdock

# Alembic only: schema migration role; never use it for normal API/worker requests.
AGENTDOCK_MIGRATION_DATABASE_URL=postgresql+asyncpg://agentdock_migrator:CHANGE_ME@localhost:5432/agentdock

# Optional single-agent worker. Tasks remain QUEUED until a handler and provider are configured.
# AGENTDOCK_WORKER_HANDLER=agent
# AGENTDOCK_OPENAI_MODEL=YOUR_APPROVED_MODEL
# OPENAI_API_KEY=SET_AS_A_SECRET_NOT_IN_SOURCE_CONTROL

# Optional OIDC resource-server verification. Configure all three values together.
# The audience must identify the AgentDock API, not only the Android OAuth client.
# Use the provider's HTTPS issuer and its trusted JWKS endpoint.
# AGENTDOCK_OIDC_ISSUER=https://identity.example.com/
# AGENTDOCK_OIDC_AUDIENCE=https://api.agentdock.example
# AGENTDOCK_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Required when OIDC is enabled: JSON array of registered OAuth client IDs allowed to call AgentDock.
# AGENTDOCK_OIDC_ALLOWED_CLIENT_IDS=["agentdock-android"]
# AGENTDOCK_OIDC_ALLOWED_ALGORITHMS=["RS256"]
# Optional: require the access token's azp claim to match the Android OAuth client ID.
# AGENTDOCK_OIDC_AUTHORIZED_PARTY=agentdock-android
# AGENTDOCK_OIDC_CLOCK_SKEW_SECONDS=30
# AGENTDOCK_OIDC_JWKS_TIMEOUT_SECONDS=5
